#!/usr/bin/env bash
# 共享库依赖守卫的 pre-push 钩子。启用(每个克隆一次):git config core.hooksPath .githooks
#
# git 通过 stdin 传入每个被推送的引用:<local ref> <local sha> <remote ref> <remote sha>
# 推 main 或 tag:阻断类问题拦下推送;推其他分支:同样的检查,阻断降级为警告。
# 确认要绕过时:git push --no-verify
set -u
root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
status=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # 删除远端引用,没有内容可检查
  args=(--rev "$local_sha")
  strict=1
  case "$remote_ref" in
    refs/heads/main | refs/tags/*) ;;
    *) strict=0; args+=(--downgrade-blocks) ;;
  esac
  echo "shared-deps: 检查 $remote_ref" >&2
  rc=0
  "$root/scripts/check-shared-deps.sh" "${args[@]}" || rc=$?
  case "$rc" in
    0) ;;
    3) # 脚本自己跑不起来(环境问题),不是依赖问题:推 main/tag 时仍然拦下(fail-closed),其他分支只警告
      if [ "$strict" = 0 ]; then
        echo "pre-push: 共享库依赖检查在这台机器上没法运行(见上面的错误),本次推送不拦" >&2
      else
        echo "pre-push: 共享库依赖检查没法运行(环境问题,不是依赖问题),推 main/tag 时保守拦下。装好 Python 3.11+ 后重试;确认要绕过时用 git push --no-verify" >&2
        status=1
      fi
      ;;
    *) status=1 ;;
  esac
done
if [ "$status" -ne 0 ]; then
  echo "pre-push: 共享库依赖检查未通过,已拦下推送。修复后重试;确认要绕过时用 git push --no-verify" >&2
fi

# 外壳区域一致性(Tier5 Task3):Dozer workspace.json ≡ byteui 导出,消除人工比对。
# 找不到 sibling byteui 时脚本自己跳过(单独 checkout / CI 里没拉 byteui)。
if ! "$root/scripts/check-shell-regions.sh"; then
  echo "pre-push: 外壳区域一致性检查未通过(见上),已拦下推送。确认要绕过时用 git push --no-verify" >&2
  status=1
fi

# 业务层宿主依赖门禁(bytehost 优化 Tier5 Task2):dozer-model/services/store-project 等
# 业务 crate 不得直连 bytehost-*/iced/wry。dozer 目前没有远程 CI,pre-push 是唯一的自动门禁。
if ! "$root/scripts/check-host-deps.sh"; then
  echo "pre-push: 业务层宿主依赖门禁未通过(见上),已拦下推送。确认要绕过时用 git push --no-verify" >&2
  status=1
fi
exit "$status"
