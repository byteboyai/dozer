{
  "name": "dozer-flyfish-renderer-text",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dozer local build of the Flyfish renderer-text IIFE (markdown/code) with the dozer markdown-media-lightbox patch. Offline bundle, no CDN/runtime Node.",
  "scripts": {
    "build": "node build.mjs",
    "build:check": "node build-check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test src/**/*.test.ts"
  },
  "dependencies": {
    "diff2html": "^3.4.56",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@file-viewer/core": "2.2.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.6",
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vite": "^6.3.5"
  }
}
